<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coztion.authority.AuthorityRepository">

    <select id="selectAuthorities"
            parameterType="com.coztion.authority.model.AuthoritiesSearch"
            resultType="com.coztion.authority.model.Authority">
        SELECT AUTHORITY_ROLE
             , AUTHORITY_NAME
             , DATA_STATUS
             , CREATED_BY
             , CREATED_AT
             , UPDATED_BY
             , UPDATED_AT
          FROM TB_AUTHORITY
         ORDER BY AUTHORITY_ROLE
    </select>

</mapper>
