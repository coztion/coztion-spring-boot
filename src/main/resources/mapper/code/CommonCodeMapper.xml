<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="coz.springboot.code.CommonCodeRepository">

    <select id="selectCommonCodes"
            parameterType="coz.springboot.code.model.CommonCodesSearch"
            resultType="coz.springboot.code.model.CommonCode">
        SELECT GROUP_CODE
             , COMMON_CODE
             , COMMON_CODE_NAME
             , COMMON_CODE_DESC AS COMMON_CODE_DESCRIPTION
             , DATA_STATUS
             , SORT_ORDER
             , CREATED_BY
             , CREATED_AT
             , UPDATED_BY
             , UPDATED_AT
          FROM TB_COMMON_CODE
         WHERE TRUE
        <if test="groupCodes != null and !groupCodes.isEmpty()">
           AND GROUP_CODE IN
            <foreach collection="groupCodes" item="groupCode" open="(" separator="," close=")">
                #{groupCode}
            </foreach>
        </if>
        <if test="groupCode != null and groupCode != ''">
           AND GROUP_CODE = #{groupCode}
        </if>
        <if test="commonCode != null and commonCode != ''">
           AND COMMON_CODE = #{commonCode}
        </if>
        <if test="dataStatus != null">
           AND DATA_STATUS = #{dataStatus}
        </if>
           AND DATA_STATUS = 'ENABLED'
         ORDER BY SORT_ORDER
    </select>

</mapper>
