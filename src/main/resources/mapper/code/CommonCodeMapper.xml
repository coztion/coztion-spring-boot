<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="coz.springboot.core.code.repository.CommonCodeRepository">

    <select id="findCommonCodesByParam"
            parameterType="coz.springboot.core.code.dto.CommonCodeSearchParam"
            resultType="coz.springboot.core.code.vo.CommonCode">
        SELECT GROUP_CODE
             , COMMON_CODE
             , COMMON_CODE_NAME
             , USE_YN AS IS_USE
             , CREATED_BY
             , CREATED_AT
             , UPDATED_BY
             , UPDATED_AT
          FROM TB_COMMON_CODE
         <where>
            <if test="groupCode != null and groupCode != ''">
           AND GROUP_CODE = #{groupCode}
            </if>
            <if test="commonCode != null and commonCode != ''">
           AND COMMON_CODE = #{commonCode}
            </if>
            <if test="isUse != null">
           AND USE_YN = #{isUse}
            </if>
         </where>
         ORDER BY COMMON_CODE
    </select>

    <select id="findCommonCodeByParam"
            parameterType="coz.springboot.core.code.dto.CommonCodeSearchParam"
            resultType="coz.springboot.core.code.vo.CommonCode">
        SELECT GROUP_CODE
             , COMMON_CODE
             , COMMON_CODE_NAME
             , USE_YN AS IS_USE
             , CREATED_BY
             , CREATED_AT
             , UPDATED_BY
             , UPDATED_AT
          FROM TB_COMMON_CODE
         <where>
            <if test="groupCode != null and groupCode != ''">
           AND GROUP_CODE = #{groupCode}
            </if>
            <if test="commonCode != null and commonCode != ''">
           AND COMMON_CODE = #{commonCode}
            </if>
            <if test="isUse != null">
           AND USE_YN = #{isUse}
            </if>
         </where>
    </select>

</mapper>
