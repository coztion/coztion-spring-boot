<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coztion.user.UserRepository">

    <resultMap id="findUserByParamMap" type="com.coztion.user.model.User">
        <id property="username" column="USERNAME" />
        <collection property="authorities" ofType="com.coztion.user.model.Authority">
            <result property="authorityCode" column="AUTHORITY_CODE"/>
        </collection>
    </resultMap>

    <select id="selectUser"
            parameterType="com.coztion.user.model.UserSearch"
            resultMap="findUserByParamMap">
        SELECT U.USERNAME
             , U.PASSWORD
             , UA.AUTHORITY_CODE
          FROM TB_USER U
          LEFT JOIN TB_USER_AUTHORITY UA
                 ON U.USERNAME = UA.USERNAME
        <if test="username != null and username != ''">
         WHERE U.USERNAME = #{username}
        </if>
    </select>

</mapper>