<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="coz.springboot.repository.user.UserRepository">

    <resultMap id="findUserByParamMap" type="coz.springboot.domain.user.User">
        <id property="username" column="USERNAME" />
        <collection property="authorities" ofType="coz.springboot.enums.user.Authority">
            <result property="authorityCode" column="AUTHORITY_CODE"/>
        </collection>
    </resultMap>

    <select id="findUsersByFilter"
            parameterType="coz.springboot.domain.user.UserFilter"
            resultMap="findUserByParamMap">
        SELECT U.USERNAME
             , U.PASSWORD
             , A.AUTHORITY_CODE
          FROM TB_USER U
          LEFT JOIN TB_USER_AUTHORITY UA
                 ON U.USERNAME = UA.USERNAME
          LEFT JOIN TB_AUTHORITY A
                 ON UA.AUTHORITY_CODE = A.AUTHORITY_CODE
        <if test="username != null and username != ''">
         WHERE U.USERNAME = #{username}
        </if>
    </select>

    <select id="findUserByFilter"
            parameterType="coz.springboot.domain.user.UserFilter"
            resultMap="findUserByParamMap">
        SELECT U.USERNAME
             , U.PASSWORD
             , UA.AUTHORITY_CODE
          FROM TB_USER U
          LEFT JOIN TB_USER_AUTHORITY UA
                 ON U.USERNAME = UA.USERNAME
        <if test="username != null and username != ''">
         WHERE U.USERNAME = #{username}
        </if>
    </select>

</mapper>