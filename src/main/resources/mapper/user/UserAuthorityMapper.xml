<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coztion.user.UserAuthorityRepository">

    <select id="selectUserAuthorities"
            parameterType="com.coztion.user.model.UserAuthoritiesSearch"
            resultType="com.coztion.user.model.UserAuthority">
        SELECT UA.USERNAME
             , UA.AUTHORITY_ROLE
          FROM TB_USER_AUTHORITY UA
         WHERE TRUE
        <if test="username != null and username != ''">
           AND UA.USERNAME = #{username}
        </if>
        <if test="usernames != null and !usernames.isEmpty()">
           AND UA.USERNAME IN
            <foreach collection="usernames" item="username" open="(" separator="," close=")">
                #{username}
            </foreach>
        </if>
        <if test="authorityRole != null and authorityRole != ''">
           AND UA.AUTHORITY_ROLE = #{authorityRole}
        </if>
         ORDER BY UA.USERNAME
    </select>

</mapper>
